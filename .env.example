# Copy to .env.local for local development (never commit .env.local).
# In Vercel, set these under Project -> Settings -> Environment Variables.
# Both values are public by design (protected by Row Level Security). NEVER put the
# Supabase service_role key, the Mighty client secret or the Mighty Admin API key
# in any VITE_* variable: those live only in Supabase -> Edge Functions -> Secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# development | preview | production  (anything but production shows a TEST badge)
VITE_APP_ENV=preview
